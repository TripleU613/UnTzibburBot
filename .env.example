# --- Telegram -------------------------------------------------------------
# From @BotFather. Also enable: Bot Settings → Threaded Mode (topics in private chats).
TELOXIDE_TOKEN=123456:ABC...

# --- Directus -------------------------------------------------------------
DB_PASSWORD=change-me
DIRECTUS_SECRET=change-me-long-random
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
# Static token the bridge authenticates with (any long random string; Directus assigns it to the admin on first boot).
DIRECTUS_TOKEN=change-me-long-random-token
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Admin UI bind (loopback by default; use your Tailscale IP to reach it from your tailnet)
DIRECTUS_BIND=127.0.0.1
DIRECTUS_PORT=8055
# Optional: age public key (age-keygen). Backups are encrypted to it; keep the private key off the server.
BACKUP_AGE_RECIPIENT=

# --- Bridge ---------------------------------------------------------------
# openssl rand -base64 32
# Root of all data-at-rest keys (session tokens, local caches). Back it up separately from the database.
BRIDGE_MASTER_KEY=
# To rotate: move the old value here, put a new one in BRIDGE_MASTER_KEY, restart. Sessions and
# caches are re-encrypted as they are used; remove this after a restart or two.
BRIDGE_MASTER_KEY_PREVIOUS=
# Public HTTPS URL (reverse proxy → bridge:8080). Enables webhook mode and the Mini App login page.
# Leave empty to long-poll (no inbound connectivity needed).
BRIDGE_PUBLIC_URL=
# Use a Telegram webhook instead of long polling (needs BRIDGE_PUBLIC_URL routed to the container)
BRIDGE_USE_WEBHOOK=false
# Telegram user id of the operator: gets /stats and rate-limited error alerts (ids only)
BRIDGE_ADMIN_TELEGRAM_ID=
# Local bind for the HTTP port (health + Mini App)
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=8081
# Country assumed when a user types a number without a country code
BRIDGE_DEFAULT_REGION=US
BRIDGE_HISTORY_IMPORT=20
TZIBBUR_BASE_URL=https://api.tzibbur.me
RUST_LOG=info
